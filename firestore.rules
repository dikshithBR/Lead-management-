rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidLead(data) {
      return data.keys().hasAll(['id', 'name', 'phone', 'stage', 'nextActionNote', 'actionDueDate', 'leadSource', 'venue'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30
        && data.stage in ['Inquired', 'Trial', 'First Follow-up', 'Second Follow-up', 'Second Trial', 'Converted', 'Redundant']
        && data.nextActionNote is string && data.nextActionNote.size() <= 500
        && data.actionDueDate is string && data.actionDueDate.size() <= 30
        && data.leadSource is string && data.leadSource.size() > 0 && data.leadSource.size() <= 60
        && data.venue is string && data.venue.size() > 0 && data.venue.size() <= 60;
    }

    function isValidUserSettings(data) {
      return (!('customSources' in data) || data.customSources is list)
        && (!('customVenues' in data) || data.customVenues is list);
    }

    match /leads/{leadId} {
      allow read: if true;
      allow create, update: if isValidId(leadId) && isValidLead(request.resource.data);
      allow delete: if isValidId(leadId);
    }

    match /userSettings/{settingId} {
      allow read: if true;
      allow create, update: if isValidId(settingId) && isValidUserSettings(request.resource.data);
      allow delete: if isValidId(settingId);
    }
  }
}
